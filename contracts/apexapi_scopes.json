      },
      {
        "name": "apex_scrapy_read_artifact",
        "scope": "artifacts:read"
      },
      {
        "name": "apex_scrapy_scrape_result",
        "scope": "artifacts:read"
      },
      {
        "name": "apex_scrapy_scrape_url",
        "scope": "scrape:write"
      },
