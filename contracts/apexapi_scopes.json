  "rule": "A key holds a scope when it names it or holds '*'. A route needs one of scopes_any_of when auth is api_key; admin_token routes need the operator's admin token instead, and none routes need no credential. Two requests need more than their route or tool lists: the json scrape format needs ai:use (ApexAPI and MCP), and cancelling a job through ApexAPI needs the scope that starts that kind of job (ai:use for an AI extraction job, else scrape:write). An MCP tool with a null scope needs only a key.",
  "schema_version": 1,
  "scopes": [
    {
      "default": true,
      "description": "Start and quote jobs (Scrapy commands, scrape, map, batch, crawl and asset extraction), change datasets (activate a version, quarantine a record) and cancel jobs.",
      "name": "scrape:write"
    },
    {
      "default": true,
      "description": "List the caller's jobs and read a job's status and JSON result.",
      "name": "jobs:read"
    },
    {
      "default": true,
      "description": "Read job artifacts, scrape, batch and asset results and files, datasets, records, documents and search.",
      "name": "artifacts:read"
    },
    {
      "default": true,
      "description": "Read the account's credit balance (or the self-hosted unmetered status).",
      "name": "credits:read"
    },
    {
      "default": false,
      "description": "Read which Scrapy commands ApexAPI exposes.",
      "name": "commands:read"
    },
    {
      "default": false,
      "description": "Add, test, remove and choose the caller's own AI provider profiles, and read their usage.",
      "name": "ai:configure"
    },
    {
      "default": false,
      "description": "Run AI extraction and questions with the caller's own AI provider, spending that provider's credit (also the json scrape format and cancelling the caller's AI extraction jobs).",
      "name": "ai:use"
    }
  ],
  "wildcard": "*"
}
